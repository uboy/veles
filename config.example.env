# Пример файла настроек veles.
# Скопируйте его в .env рядом с местом запуска и подставьте СВОИ значения:
#   cp config.example.env .env
# Обязательно подставить только адрес языковой модели и ключ (раздел 1).
# Всё остальное уже настроено на проверенные значения по умолчанию;
# модели поиска скачиваются автоматически при первом запуске.
# Существующие переменные окружения .env не перекрывает.

# --- 1. Языковая модель: составляет ответы из найденных цитат ---------------
# Без неё база работает как поиск с цитатами. Подойдёт любой сервер с
# OpenAI-совместимым API: llama-server, LM Studio, Ollama, облачный API.
VELES_LLM_BASE_URL=http://127.0.0.1:8080/v1
VELES_LLM_MODEL=gemma-4-31b-it
VELES_LLM_API_KEY=

# Проверенные конфигурации (что выбрать - см. docs/REQUIREMENTS.md, раздел
# «Модели»):
#   Своя модель 30B-класса на видеокарте 24-32 ГБ (лучшее качество,
#   llama-server, файл в 4-битном сжатии ~20 ГБ):
#     VELES_LLM_BASE_URL=http://127.0.0.1:8080/v1
#     VELES_LLM_MODEL=gemma-4-31b-it
#   Небольшая модель на обычном ПК с 16 ГБ памяти (Ollama):
#     VELES_LLM_BASE_URL=http://127.0.0.1:11434/v1
#     VELES_LLM_MODEL=qwen3:8b
#   Облачный API (пример DeepSeek; вопросы и цитаты уходят в облако):
#     VELES_LLM_BASE_URL=https://api.deepseek.com/v1
#     VELES_LLM_MODEL=deepseek-chat
#     VELES_LLM_API_KEY=sk-...

# --- 2. Поиск по тексту: скачивается автоматически при первом запуске ------
# По умолчанию - intfloat/multilingual-e5-small (~450 МБ, быстрый, работает
# на процессоре, русский и английский).
# Проверенная замена для баз со смешанными русско-английскими документами
# (наши замеры в evals/results/: на вики-наборе 470 вопросов находит верную
# страницу в топ-5 в 85% против 69% у e5-small; требует пересборки индекса
# и ~1.2 ГБ вместо ~450 МБ):
# VELES_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- 3. Сервер --------------------------------------------------------------
# Токен обязателен, если сервер доступен с других машин сети (защита:
# без токена сервер наружу не стартует). Для работы только на этом
# компьютере оставьте пустым.
VELES_API_TOKEN=
# Каталог данных (индекс, документы, загрузки); по умолчанию ./data
# VELES_DATA=C:\veles-data
# Жёсткий кап размера одной загрузки, МБ
VELES_UPLOAD_MAX_MB=150

# --- 4. Поиск по изображениям (дополнение, по умолчанию выключен) ----------
# Включается путём к собранному индексу картинок (docs/REQUIREMENTS.md,
# раздел «Поиск по изображениям»); требует хост с 16 ГБ памяти:
# VELES_IMAGE_INDEX_DIR=
