# .env.example - все переменные deploy-kit veles.
# install.sh копирует нужные в .env (chmod 600); значения GENERATE заменяются
# на сгенерированные секреты (openssl rand -hex 32). Ключи LLM - только ручной ввод
# пользователя при установке, в архив не встраиваются.

# ---------- профиль кита (пишет install.sh) ----------
VELES_KIT_PROFILE=corporate
VELES_WITH_WEBUI=0
VELES_WITH_BRIDGE=0
VELES_WITH_VOXFUSION=0

# ---------- порты ----------
VELES_FACADE_PORT=8400
VELES_WEBUI_PORT=8300

# ---------- пути ----------
# Хост-пути к данным (bind-каталоги compose, каталог установки)
VELES_DATA=./data
VELES_CORPUS_ROOT=./corpus

# ---------- секреты: GENERATE -> генерируется при установке (всегда) ----------
# bearer фасада (служебный доступ владельца: CLI, мост)
VELES_API_TOKEN=GENERATE
# секрет подписанных ссылок на источники (exp+sig); генерится всегда
VELES_LINK_SECRET=GENERATE
# секрет WebUI (сессии)
WEBUI_SECRET_KEY=GENERATE

# ---------- личность (K1) ----------
# static - личный профиль (bearer владельца); корпоративный (K5 corporate) ставит
# jwt по умолчанию: подписанный заголовок X-OpenWebUI-User-Jwt, секрет генерится
# установщиком. headers - только явный opt-in (--identity-headers): заголовкам
# можно подделать личность при прямом доступе к фасаду в обход Open WebUI -
# требуется сетевой ACL. fail-closed: corporate не поднимается без identity-режима.
VELES_IDENTITY_MODE=static
# только jwt: секрет подписи X-OpenWebUI-User-Jwt (GENERATE -> генерируется)
VELES_IDENTITY_JWT_SECRET=GENERATE
# тот же секрет для Open WebUI (автоматически синхронизируется install.sh)
FORWARD_USER_INFO_HEADER_JWT_SECRET=
# Open WebUI передаёт пользователя заголовками (headers/jwt)
ENABLE_FORWARD_USER_INFO_HEADERS=false
# админы (email через запятую); пусто - админов нет
VELES_ADMIN_EMAILS=
# группы доступа по умолчанию
VELES_ALLOWED_GROUPS=personal
# группы при загрузке (K7): определения и состав - <VELES_DATA>/groups.json
# (шаблон с дефолтными «видно всем»/«видно по запросу»/«тестовый отдел» создаёт
# GET /v1/groups; состав не-all групп правит админ в файле, рестарт не нужен).
# Путь можно переопределить:
#VELES_GROUPS_FILE=

# ---------- LLM для синтеза ответов (OpenAI-совместимый; можно пусто) ----------
# Пусто - фасад отвечает извлечёнными фрагментами без синтеза.
VELES_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
VELES_LLM_MODEL=glm-5.3-flash
VELES_LLM_API_KEY=

# ---------- Open WebUI ----------
# Брендинг: ребрендинг Open WebUI разрешён лицензией при <=50 пользователях
# (решение владельца 28.09)
WEBUI_NAME=Veles
ENABLE_SIGNUP=false
DEFAULT_MODELS=veles-knowledge
# соединения WebUI: 1) фасад veles (в compose-сети), 2) внешний LLM
OPENAI_API_BASE_URLS=http://veles-facade:8400/v1
# ключи по соединениям: bearer фасада, затем ключ LLM
OPENAI_API_KEYS=

# ---------- Telegram-мост (compose-профиль bridge / --with-bridge) ----------
TELEGRAM_BOT_TOKEN=
# прокси для api.telegram.org, если сеть закрыта DPI: http://user:pass@host:port
TG_PROXY=
# модель WebUI для бота
OPENWEBUI_MODEL=veles-knowledge
OPENWEBUI_KB_MODEL=veles-knowledge
PAIR_MODE=1

# ---------- транскрипция voxfusion-api (внешний сервис) ----------
VOXFUSION_API_URL=
VOXFUSION_API_TOKEN=

# ---------- rate-limit фасада (K6) ----------
# запросов в минуту на личность (identity-режимы) / на токен (static);
# 0 = выключить; пусто = щедрый дефолт (240)
VELES_RATE_LIMIT_RPM=

# ---------- TLS (corporate, compose-профиль tls; K6, опционально) ----------
# домен для авто-HTTPS caddy (должен указывать на сервер, 80/443 открыты);
# конфиг - caddy/Caddyfile, скопируйте из caddy/Caddyfile.example
#VELES_TLS_DOMAIN=veles.example.com
# при TLS-профиле привяжите WebUI к loopback - наружу хоста смотрит только caddy
#VELES_WEBUI_BIND=127.0.0.1
